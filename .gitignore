# Design diagrams (large local reference)
fig_const

# Recorded data, reports, converted datasets (from the diagrams' /data path).
# Keep the directory (so the ./data -> /data mount exists and is user-owned,
# avoiding a root-owned mount), but ignore everything written into it.
data/*
!data/.gitkeep
*.mcap

# Local-only robot configs (UNTRACKED): RECORDING_CONFIG / validation YAML for
# confidential robots whose names/topics must not be committed. The whole
# config/ dir is mounted into the containers (./config:/config:ro), so a file
# here is reachable as /config/local/<robot>.yaml without being tracked. The
# README + .gitkeep stay tracked so the mechanism is documented.
config/local/*
!config/local/.gitkeep
!config/local/README.md

# Secrets
.env
.env.*
*.pem
*.key
# ...but the committed templates must be tracked.
!.env.example
!.env.split.example

# Claude Code — personal settings only (shared settings.json IS committed)
.claude/settings.local.json

# UI/UX Pro Max skill (installed via `uipro init --ai claude`, not committed)
.claude/skills/ui-ux-pro-max/

# Claude Code session worktrees (live git worktrees, never committed)
.claude/worktrees/

# Playwright MCP browser profile
.playwright-mcp/

# Issue log: local-only problem/solution notes (see .claude/skills/issue-log)
/issue/

# Local staged-implementation working draft (not a committed doc)
dev_docs/
plan.md
plan_ui.md
plan_config.md
report.md
check.md
task.md

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/

# Python build / cache artifacts
__pycache__/
*.egg-info/
.ruff_cache/
.pytest_cache/
.venv/

# Node / frontend build artifacts
node_modules/
dist/
*.tsbuildinfo

# ROS 2 / colcon build dirs
build/
install/
log/

# Custom-message overlay: ignore everything dropped here (msg package SOURCES +
# colcon build artifacts) except the tracked README — keeps confidential message
# packages (e.g. a robot's proprietary interfaces) local and out of git.
/deploy/msgs_overlay/*
!/deploy/msgs_overlay/README.md
# Ship the empty default 'robot' overlay dir (so the default bind mount exists
# and stays user-owned, never erroring) — but still ignore any msg sources /
# build artifacts dropped into it.
!/deploy/msgs_overlay/robot/
/deploy/msgs_overlay/robot/*
!/deploy/msgs_overlay/robot/.gitkeep

# 参考フォルダ
/ref

# Scratch UI verification shots (Playwright screenshots dropped at repo root or
# into per-service .dev/shots/ during UI checks — local scratch, never tracked).
/*.png
.dev/
