# =============================================================================
# kairos — RECORDING-PC env for the cross-host (robot-edge) split.
# Copy to `.env` ON THE RECORDING PC, set ROBOT_IP, then:
#     docker compose -f compose.recording.yaml up -d --build   (or: make recording-up)
#
# The robot runs compose.robot.yaml (recorder/monitor/streamer/probe) and shares
# the robot's DDS graph locally. This PC runs orchestrator/dora/frontend, joins
# NO DDS, and reaches the robot-edge services over HTTP at the robot's LAN IP.
# Only lightweight data crosses the LAN — the robot's onboard system is not loaded.
# Full rationale: docs/specs/ja/deployment_topology.md.
# =============================================================================

# ---- The robot's LAN IP (the one place to edit) -----------------------------
# Use an IP (or an /etc/hosts entry). nginx bakes these into static upstreams at
# container start, so a hostname is resolved once at nginx startup.
#   export ROBOT_IP=192.168.1.50   # then the *_HOST below pick it up
ROBOT_IP=192.168.1.50

# ---- Downstream service hosts (orchestrator -> robot-edge services) ----------
# The four DDS-reading services run on the robot; point the orchestrator at them.
RECORDER_HOST=${ROBOT_IP}
TOPIC_MONITOR_HOST=${ROBOT_IP}
WEBRTC_HOST=${ROBOT_IP}
TOPIC_PROBE_HOST=${ROBOT_IP}
# dora_runner is CPU-heavy and runs on THIS PC beside the orchestrator.
DORA_RUNNER_HOST=localhost

# ---- nginx upstream hosts (frontend -> robot-edge services) ------------------
# The frontend is on this PC; the orchestrator is co-located here (API_HOST), but
# the streamer + probe are on the robot. NOTE: nginx proxies only the WebRTC
# *signaling*; RTP media is peer-to-peer, so the browser must reach ROBOT_IP
# directly (same-LAN premise — satisfied on a wired LAN).
API_HOST=127.0.0.1
WEBRTC_HOST=${ROBOT_IP}
PROBE_HOST=${ROBOT_IP}

# ---- Ports (must match the robot's; defaults shown) -------------------------
API_ORCH_PORT=8000
TOPIC_MONITOR_PORT=8001
WEBRTC_PORT=8002
TOPIC_PROBE_PORT=8003
RECORDER_PORT=8010
DORA_RUNNER_PORT=8020
FRONTEND_PORT=8080

# ---- Data root (PC-LOCAL) ---------------------------------------------------
# dora reads MCAP from here. `make import-runs` rsyncs COMPLETED runs from the
# robot into ./data/recorded. Do NOT NFS-mount the robot's /data here — dora
# scanning large MCAPs over NFS would make the robot serve disk/network.
DATA_DIR=./data

# ---- Robot / config (informational on this PC) ------------------------------
# The orchestrator/frontend use ROBOT to label + locate the config catalog. The
# recorder's recording behavior (start_paused, max_cache_size_mb, QoS) is driven
# by the ROBOT's /config (deploy-time), NOT by edits made here. To change recorder
# behavior, edit config/ on the robot and `make config-reload` there.
ROBOT=airoa_hsr
ROS_DISTRO=jazzy
# Used by import-runs (rsync source). Set to the robot's ssh user + data path.
ROBOT_SSH=robot@${ROBOT_IP}
ROBOT_DATA_DIR=/home/robot/kairos/data
UID=1000
GID=1000
