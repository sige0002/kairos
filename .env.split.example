# =============================================================================
# kairos — CROSS-HOST SPLIT setup.   cp .env.split.example .env.split
#
# Record from a different PC than the robot, so the robot is not loaded.
# Everything on ONE PC? Use .env.example instead.
#
#   1) Copy this to .env.split on BOTH machines (`make` prefers .env.split and
#      leaves a single-host .env untouched, so you can switch back).
#   2) Edit ONE line: ROBOT_IP. Everything below references it.
#   3) On the RECORDING PC:  make recording-up      (orchestrator/dora/frontend)
#      On the ROBOT:         make robot-up          (recorder/monitor/streamer/probe)
#
# The robot runs the four DDS-reading services; this PC joins NO DDS and reaches
# them over HTTP. Only light data crosses the LAN.
# This file is self-contained — no need to also read .env.example.
# Uncommented keys are the commonly tuned ones (values shown are defaults);
# commented keys are rare / opt-in.
# Schema: docs/specs/ja/config.md   Topology: docs/specs/ja/deployment_topology.md
# =============================================================================

# ---- the one line to edit ---------------------------------------------------
# The robot's LAN IP. Use an IP (or an /etc/hosts name): nginx resolves these
# once at container start and bakes them into static upstreams.
ROBOT_IP=192.168.1.50

# ---- service hosts (orchestrator -> robot) ----------------------------------
RECORDER_HOST=${ROBOT_IP}
TOPIC_MONITOR_HOST=${ROBOT_IP}
WEBRTC_HOST=${ROBOT_IP}
TOPIC_PROBE_HOST=${ROBOT_IP}
# dora_runner and the importer are CPU/disk-heavy and run on THIS PC.
DORA_RUNNER_HOST=localhost
#IMPORTER_HOST=localhost

# ---- nginx upstreams (frontend -> services) ---------------------------------
# The API is co-located here; streamer and probe are on the robot. nginx proxies
# only WebRTC signaling — RTP media is peer-to-peer, so the browser itself must
# be able to reach ROBOT_IP (true on a shared wired LAN).
API_HOST=127.0.0.1
PROBE_HOST=${ROBOT_IP}

# ---- robot ------------------------------------------------------------------
# Must match on BOTH machines, or each side loads a different robot's topics.
# Publish this PC's config to the robot with `make push-config`.
ROBOT=airoa_hsr
#CONFIG_DIR=config
#CONFIG_LOCAL_DIR=config/local

# ---- per-robot config paths (derived) ---------------------------------------
# `make` derives these from ROBOT. Set one ONLY to override that path — a stale
# absolute value here silently beats the robot you selected.
#RECORDING_CONFIG=/config/airoa_hsr/recording/default.yaml
#STREAM_CONFIG=/config/airoa_hsr/stream/default.yaml
#ALERT_CONFIG_PATH=/config/airoa_hsr/monitoring/alerts.yaml
#LOSS_REPORT_CONFIG=/config/airoa_hsr/validators/loss_report.yaml
#BAGFLOW_FLOWS_DIR=/config/airoa_hsr/flows
# Custom ROS messages — needed on the ROBOT side. Must start with ./
#MSGS_OVERLAY_DIR=./deploy/msgs_overlay/airoa_hsr

# ---- ROS 2 graph (robot side) -----------------------------------------------
# Must match the robot's own graph; this PC never joins DDS.
ROS_DOMAIN_ID=0
ROS_DISTRO=jazzy
# Changing ROS_DISTRO also requires a digest-pinned base that contains it:
# ROS_BASE_IMAGE=ros:<distro>-ros-base@sha256:<manifest-digest>
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
#CYCLONEDDS_URI=file:///config/cyclonedds-localhost.xml

# ---- ports (must match on both machines) ------------------------------------
FRONTEND_PORT=8080
API_ORCH_PORT=8000
TOPIC_MONITOR_PORT=8001
WEBRTC_PORT=8002
TOPIC_PROBE_PORT=8003
RECORDER_PORT=8010
DORA_RUNNER_PORT=8020
# 0.0.0.0 is required on the ROBOT so this PC can reach its services.
BIND_HOST=0.0.0.0

# ---- data root (PC-LOCAL) ---------------------------------------------------
# dora reads MCAP from here. Do NOT NFS-mount the robot's /data: scanning large
# MCAPs over NFS would put the robot back to work serving disk and network.
DATA_DIR=./data
# Robot-side recording root, and the ssh target used to pull runs from it.
ROBOT_DATA_DIR=/home/robot/kairos/data
ROBOT_SSH=robot@${ROBOT_IP}

# ---- run transfer (importer sidecar + `make import-runs`) -------------------
# Passwordless auth to the robot — set exactly ONE, or automated pulls hang on
# an ssh prompt. Key is preferred; the password path needs `sshpass`.
#   ssh-keygen -t ed25519 -f ~/.ssh/kairos_robot -N ''
#   ssh-copy-id -i ~/.ssh/kairos_robot.pub robot@<ROBOT_IP>
#ROBOT_SSH_KEY=/home/you/.ssh/kairos_robot
#ROBOT_SSH_PASSWORD=
# rsync bandwidth cap in KB/s; 0 = unlimited.
#BWLIMIT=0
# Importer sidecar bind address and port (this PC, container-internal).
#IMPORTER_BIND=127.0.0.1
#IMPORTER_PORT=8030
# Periodic catch-up pull, in seconds; 0 disables (pulls happen on request).
#IMPORT_SWEEP_S=0
# Retries and delay when finalising a pulled run into objects/.
#IMPORT_FINALISE_RETRIES=10
#IMPORT_FINALISE_RETRY_DELAY_S=3
# Auto-pull after Collect Save is a CONFIG option, not an env var:
# transfer.auto_pull_on_save in config/<robot>/recording/default.yaml. Off by
# default — nothing is transferred without an explicit opt-in.

# ---- archive ----------------------------------------------------------------
# Opt-in, recording PC only (no orchestrator runs on the robot). BOTH lines are
# required: the host path to mount, and the in-container path allowed as a
# destination. One without the other is the trap where exports verify and then
# vanish with the container.
#ARCHIVE_DIR=/mnt/nas/kairos-archive
#KAIROS_ARCHIVE_ROOTS=/archive
RETENTION_DAYS=0

# ---- recording limits (robot side) ------------------------------------------
MAX_RECORD_SECONDS=600
MAX_RECORD_BYTES=0

# ---- browser-facing (frontend / WebRTC) -------------------------------------
# Same-origin path proxied by this PC's nginx — keeps the preview working from
# any access origin with no CORS.
WEBRTC_PUBLIC_URL=/webrtc
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
# Same LAN or Tailscale needs nothing here. Across NAT or WiFi client isolation,
# add STUN and/or the TURN relay in compose/turn.yaml.
#WEBRTC_ICE_SERVERS=[{"urls":["stun:stun.l.google.com:19302"]},{"urls":["turn:${ROBOT_IP}:3478"],"username":"kairos","credential":"changeme"}]
# 1150 keeps media under a 1280-MTU tunnel (Tailscale/WireGuard); 1300 on a
# plain LAN. A black preview over a tunnel is almost always this.
#WEBRTC_PACKET_MAX=1150
#WEBRTC_KEEP_IPV6=0
# Bundled TURN relay (compose/turn.yaml). The IP is REQUIRED once that file is
# used — compose refuses to start without it. Change the credentials.
#TURN_EXTERNAL_IP=192.168.1.10
#TURN_USERNAME=kairos
#TURN_PASSWORD=changeme

# ---- Review video preview ---------------------------------------------------
# Default frame cap for the video_check preview; 0 = the whole episode.
VIDEO_MAX_FRAMES=0
VIDEO_PLAYBACK_RATE=4.0
# x264 encode knobs. Defaults trade NO quality (x264's own medium / crf 23)
# and cap threads at 4; set preset=veryfast where encode speed matters more.
#VIDEO_ENCODE_THREADS=4
#VIDEO_ENCODE_PRESET=medium
#VIDEO_ENCODE_CRF=23

# ---- dora_runner (this PC) --------------------------------------------------
#KAIROS_DORA_MAX_CONCURRENCY=4
#KAIROS_DORA_JOB_TIMEOUT_S=900
#DORA_RUNNER_SHM_SIZE=2gb
#KAIROS_DORA_CONTROL_PORT=6112
#KAIROS_DORA_DAEMON_PORT=53390
#KAIROS_DORA_DAEMON_LISTEN_PORT=53391
#KAIROS_DORA_COORDINATOR_ADDR=127.0.0.1
#KAIROS_DORA_INPROCESS=0
#KAIROS_BAGFLOW_TIMEOUT_S=600
#KAIROS_PLUGINS_DIR=

# ---- replay harness (ROBOT side: make rosbag / rosbag-loop) -----------------
# The player joins DDS, so it runs where the graph is — the robot. Path under
# that machine's data/ (or /data/...). LOOP=--loop makes `make rosbag` repeat.
#BAG=airoa-moma-mcap/000730
#LOOP=

# ---- operational ------------------------------------------------------------
LOG_LEVEL=INFO
#TZ=Asia/Tokyo
#UID=1000
#GID=1000
#KAIROS_VERSION=dev
#KAIROS_GIT_SHA=unknown

# ---- proxy exemption (only behind a corporate proxy) ------------------------
# Docker injects HTTP(S)_PROXY into every container, and LAN calls to the robot
# would then be routed to the proxy and fail. 169.254.0.0/16 covers a directly
# cabled NIC with no DHCP; ROBOT_IP is the exact-match fallback for tools that
# ignore CIDR ranges (Python's urllib does plain suffix matching).
NO_PROXY=localhost,127.0.0.1,169.254.0.0/16,${ROBOT_IP}
#HTTP_PROXY=
#HTTPS_PROXY=
