# Static serving for the built kairos frontend + reverse proxy to the
# api_orchestrator (/api) and the webrtc_streamer (/webrtc) so the browser
# talks to a single origin (no CORS).
#
# This is an nginx ENVSUBST TEMPLATE: the nginx image's entrypoint
# (/docker-entrypoint.d/20-envsubst-on-templates.sh) expands ${FRONTEND_PORT} /
# ${API_ORCH_PORT} / ${WEBRTC_PORT} / ${TOPIC_PROBE_PORT} and the upstream HOSTS
# (${API_HOST} / ${WEBRTC_HOST} / ${PROBE_HOST}) from the container environment
# at startup and writes the result to /etc/nginx/conf.d/default.conf. Only
# variables that exist in the environment are substituted, so nginx runtime vars
# ($host, $uri, ...) are left untouched. compose/compose.yaml passes the port/host vars
# to the frontend service, keeping this in sync with the single source of truth
# (settings.py / .env) instead of hardcoding here.
#
# The *_HOST vars default to 127.0.0.1 (single-host co-located deploy). For the
# robot-edge / recording-host SPLIT, the frontend runs on the recording PC: set
# WEBRTC_HOST / PROBE_HOST to the ROBOT's LAN IP (the streamer + probe run on the
# robot), and API_HOST to the orchestrator host (usually 127.0.0.1, co-located
# with the frontend on the recording PC). Use IPs (or /etc/hosts entries) — the
# substituted value becomes a static upstream nginx resolves at startup. NOTE:
# nginx proxies only the WebRTC *signaling*; the RTP media is peer-to-peer, so
# the browser must be able to reach the robot's IP directly (same-LAN premise).
# See docs/specs/ja/deployment_topology.md.
server {
    listen ${FRONTEND_PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # SPA fallback: client-side routing serves index.html for unknown paths.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # index.html is the ONLY unhashed file, and it is what names the hashed
    # bundle — so it must always be revalidated. Without an explicit
    # Cache-Control nginx sends only Last-Modified/ETag, and a browser is then
    # free to apply HEURISTIC freshness: it can keep serving the previous
    # index.html (and the bundle it names) from cache for a while after a
    # deploy, which looks exactly like "the fix did not ship".
    location = /index.html {
        add_header Cache-Control "no-cache" always;
    }

    # Vite's hashed assets are immutable by construction (the content hash is in
    # the filename), so they are safe to cache hard — a changed file gets a new
    # name and is fetched as a new URL.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    # Proxy API + SSE to the orchestrator. compose/compose.yaml runs every service on
    # host networking (see its networking note), so the orchestrator is reached
    # at localhost:<API_ORCH_PORT> rather than by a compose service name.
    location /api/ {
        proxy_pass http://${API_HOST}:${API_ORCH_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # SSE: disable buffering so events stream through promptly.
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
    }

    # Proxy WebRTC signaling (stream/start, stream/offer) to the webrtc_streamer
    # so the browser reaches it on the SAME origin — no CORS, and the camera
    # preview works over any access path (LAN IP / SSH tunnel / Tailscale), not
    # just a browser running on the host. The frontend uses the relative base
    # "/webrtc" (api_orchestrator WEBRTC_PUBLIC_URL default). The trailing slash
    # on proxy_pass strips the prefix: /webrtc/stream/start -> /stream/start.
    location /webrtc/ {
        proxy_pass http://${WEBRTC_HOST}:${WEBRTC_PORT}/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # Fail fast when the upstream host is down (robot powered off in the
        # cross-host split): nginx's 60s default would leave the camera pane
        # "negotiating" for a minute before it errors.
        proxy_connect_timeout 3s;
        proxy_read_timeout 1h;
    }

    # Proxy the topic_probe service (OL-3.3: numeric-field live plotter) on the
    # SAME origin, mirroring /webrtc/. The trailing slash on proxy_pass strips
    # the prefix: /probe/stream -> /stream. /probe/stream is an SSE endpoint, so
    # proxy_buffering must be off (like /api/) for samples to stream promptly.
    location /probe/ {
        proxy_pass http://${PROBE_HOST}:${TOPIC_PROBE_PORT}/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_buffering off;
        proxy_cache off;
        # Fail fast when the upstream host is down (see /webrtc/ above).
        proxy_connect_timeout 3s;
        proxy_read_timeout 1h;
    }
}
