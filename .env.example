# =============================================================================
# kairos infrastructure config (root .env) — three-layer config #1.
# Copy to `.env` and adjust. docker compose reads this and passes the values to
# each service. The canonical schema is docs/specs/ja/config.md.
# Network assumption: trusted LAN, no auth. LAN exposure is allowed; do NOT
# expose directly to untrusted networks (e.g. the internet).
# =============================================================================

# ---- ROS 2 graph (shared by all services) ----------------------------------
ROS_DOMAIN_ID=0
ROS_DISTRO=jazzy
RMW_IMPLEMENTATION=rmw_fastrtps_cpp # RMW_IMPLEMENTATION=rmw_cyclonedds_cpp

# ---- Data / config paths (robot-first) -------------------------------------
DATA_DIR=./data
# A single ROBOT selects the whole config set. With `make`, set only ROBOT — the
# Makefile derives the per-aspect paths below (committed: config/<robot>/,
# gitignored: config/local/<robot>/). The explicit paths are the compose-only
# fallback for `docker compose` without make. They are CONTAINER-ABSOLUTE
# (`/config/...`, where compose mounts ./config -> /config) so they resolve
# regardless of the container's working directory.
ROBOT=airoa_hsr
RECORDING_CONFIG=/config/airoa_hsr/recording/default.yaml
STREAM_CONFIG=/config/airoa_hsr/stream/default.yaml
LOSS_REPORT_CONFIG=/config/airoa_hsr/validators/loss_report.yaml

# ---- HTTP bind + ports ------------------------------------------------------
# 0.0.0.0 allows LAN exposure on a trusted LAN (no auth).
BIND_HOST=0.0.0.0
API_ORCH_PORT=8000
TOPIC_MONITOR_PORT=8001
WEBRTC_PORT=8002
# topic_probe: generic numeric-field live plotter (decodes one topic at a time).
TOPIC_PROBE_PORT=8003
FRONTEND_PORT=8080

# ---- Frontend-facing URLs / CORS --------------------------------------------
# Base URL the frontend uses for camera (WebRTC) signaling. Default '/webrtc' is
# a same-origin path the frontend's nginx reverse-proxies to webrtc_streamer, so
# the preview works over LAN IP / SSH tunnel / Tailscale with no CORS. Use an
# absolute http://<host>:8002 only for the legacy direct-to-streamer mode.
WEBRTC_PUBLIC_URL=/webrtc
# Origins allowed by orchestrator and webrtc_streamer (served + dev).
# Comma-separated. Add the host origin when exposing on the LAN.
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# ---- Operational ------------------------------------------------------------
LOG_LEVEL=INFO
# 0 disables retention; >0 marks runs older than N days as deletion candidates.
RETENTION_DAYS=0
# 0 means unlimited; >0 auto-stops recording when the run exceeds this size.
MAX_RECORD_BYTES=0
# Optional: container-absolute path to the topic_monitor alert-definition file.
# Convention: config/<robot>/monitoring/alerts.yaml (a config/local/<robot>/...
# override wins). Empty = alerts disabled. `make` derives this from ROBOT; set
# it here only for plain `docker compose` (without make).
# ALERT_CONFIG_PATH=/config/airoa_hsr/monitoring/alerts.yaml

# ---- Host user (bind-mount ownership) ---------------------------------------
# The orchestrator/dora_runner images are non-root; compose runs them as
# `user: "${UID:-1000}:${GID:-1000}"` so they can write the host-owned ./data and
# ./config bind mounts. `make` exports the real host UID/GID (id -u / id -g)
# automatically. For plain `docker compose` on a host whose uid/gid is NOT 1000,
# export them first so writes succeed: `export UID=$(id -u) GID=$(id -g)`.
# (bash leaves UID unexported and never sets GID, so they are not read from here.)

# Internal service ports (host networking binds these to the host)
RECORDER_PORT=8010
DORA_RUNNER_PORT=8020

# ---- Custom ROS 2 message overlay (per-robot) ------------------------------
# The recorder + monitor mount this dir and source <dir>/install/setup.bash so
# they can record / monitor CUSTOM message types on a live robot. Build it with:
#   make msgs-build MSGS_OVERLAY_DIR=./deploy/msgs_overlay/<robot>
# MUST start with ./ (compose treats a source without ./ as a named volume).
# The default 'robot' overlay ships empty -> standard types only (NOT an error).
# Point it at a per-robot overlay to use that robot's messages:
#   MSGS_OVERLAY_DIR=./deploy/msgs_overlay/<robot>
MSGS_OVERLAY_DIR=./deploy/msgs_overlay/robot