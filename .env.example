# =============================================================================
# kairos settings — SINGLE-PC setup (everything on one machine). START HERE.
#
#   1) Copy this file:   cp .env.example .env
#   2) In most cases, leave it as-is — the defaults run the bundled sample bag.
#      To use a different robot, change only ROBOT= (see "robot-first" below).
#
# docker compose reads .env and passes these values to every service.
# Recording from a SEPARATE PC instead (so the robot is not loaded)? Use
# .env.split.example, NOT this file. Walkthrough: README ("Which .env do I use?").
# Full key reference: docs/specs/ja/config.md.
# Network: trusted LAN, no auth. LAN exposure is OK; never expose to the internet.
# =============================================================================

# ---- ROS 2 graph (shared by all services) ----------------------------------
ROS_DOMAIN_ID=0
ROS_DISTRO=jazzy
RMW_IMPLEMENTATION=rmw_fastrtps_cpp # RMW_IMPLEMENTATION=rmw_cyclonedds_cpp

# ---- Data / config paths (robot-first) -------------------------------------
DATA_DIR=./data
# A single ROBOT selects the whole config set. With `make`, set only ROBOT — the
# Makefile derives the per-aspect paths below (committed: config/<robot>/,
# gitignored: config/local/<robot>/). The explicit paths are the compose-only
# fallback for `docker compose` without make. They are CONTAINER-ABSOLUTE
# (`/config/...`, where compose mounts ./config -> /config) so they resolve
# regardless of the container's working directory.
ROBOT=airoa_hsr
RECORDING_CONFIG=/config/airoa_hsr/recording/default.yaml
STREAM_CONFIG=/config/airoa_hsr/stream/default.yaml
LOSS_REPORT_CONFIG=/config/airoa_hsr/validators/loss_report.yaml

# ---- HTTP bind + ports ------------------------------------------------------
# 0.0.0.0 allows LAN exposure on a trusted LAN (no auth).
BIND_HOST=0.0.0.0
API_ORCH_PORT=8000
TOPIC_MONITOR_PORT=8001
WEBRTC_PORT=8002
# topic_probe: generic numeric-field live plotter (decodes one topic at a time).
TOPIC_PROBE_PORT=8003
FRONTEND_PORT=8080

# ---- Frontend-facing URLs / CORS --------------------------------------------
# Base URL the frontend uses for camera (WebRTC) signaling. Default '/webrtc' is
# a same-origin path the frontend's nginx reverse-proxies to webrtc_streamer, so
# the preview works over LAN IP / SSH tunnel / Tailscale with no CORS. Use an
# absolute http://<host>:8002 only for the legacy direct-to-streamer mode.
WEBRTC_PUBLIC_URL=/webrtc
# Origins allowed by orchestrator and webrtc_streamer (served + dev).
# Comma-separated. Add the host origin when exposing on the LAN.
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# ---- WebRTC ICE servers (STUN/TURN) — CROSS-NETWORK camera preview only -----
# Same-LAN or Tailscale (both peers directly routable) needs NOTHING here — a
# direct host-candidate pair already carries the video. Set this ONLY to reach
# the camera preview across NAT / WiFi client-isolation / the internet. JSON
# array in browser RTCIceServer shape; the browser AND the streamer both use it.
# A blank or malformed value safely degrades to "no ICE" (never crashes services).
#   # public STUN (helps generic NAT; needs internet access):
#   WEBRTC_ICE_SERVERS=[{"urls":["stun:stun.l.google.com:19302"]}]
#   # your own TURN relay (see compose.turn.yaml) for isolation / hard NAT:
#   WEBRTC_ICE_SERVERS=[{"urls":["turn:192.168.1.50:3478"],"username":"kairos","credential":"changeme"}]
# RTP payload cap (bytes). Default 1150 shrinks aiortc's fixed 1300 so media
# fits a reduced-MTU tunnel (Tailscale/WireGuard = 1280) without fragmenting.
# Raise to 1300 ONLY on a same-LAN (MTU 1500) deployment to cut header overhead.
#   WEBRTC_PACKET_MAX=1150
# By default the answer SDP drops IPv6 ICE candidates (fragmented IPv6 is
# black-holed over WireGuard/Tailscale -> a nominated v6 pair = black preview).
# Set to 1 ONLY on a genuinely IPv6-only network.
#   WEBRTC_KEEP_IPV6=1

# ---- Operational ------------------------------------------------------------
LOG_LEVEL=INFO
# 0 disables retention; >0 marks runs older than N days as deletion candidates.
RETENTION_DAYS=0
# 0 means unlimited; >0 auto-stops recording when the run exceeds this size.
MAX_RECORD_BYTES=0
# Hard wall-clock cap on one recording (seconds); 0 disables. Default 600 —
# the disk backstop against orphaned recordings nobody stops (a closed tab
# does NOT stop a recording; the visible Stop UI is the primary recovery).
MAX_RECORD_SECONDS=600
# Optional: container-absolute path to the topic_monitor alert-definition file.
# Convention: config/<robot>/monitoring/alerts.yaml (a config/local/<robot>/...
# override wins). Empty = alerts disabled. `make` derives this from ROBOT; set
# it here only for plain `docker compose` (without make).
# ALERT_CONFIG_PATH=/config/airoa_hsr/monitoring/alerts.yaml

# ---- Host user (bind-mount ownership) ---------------------------------------
# The orchestrator/dora_runner images are non-root; compose runs them as
# `user: "${UID:-1000}:${GID:-1000}"` so they can write the host-owned ./data and
# ./config bind mounts. `make` exports the real host UID/GID (id -u / id -g)
# automatically. For plain `docker compose` on a host whose uid/gid is NOT 1000,
# export them first so writes succeed: `export UID=$(id -u) GID=$(id -g)`.
# (bash leaves UID unexported and never sets GID, so they are not read from here.)

# Internal service ports (host networking binds these to the host)
RECORDER_PORT=8010
DORA_RUNNER_PORT=8020

# ---- Custom ROS 2 message overlay (per-robot) ------------------------------
# The recorder + monitor mount this dir and source <dir>/install/setup.bash so
# they can record / monitor CUSTOM message types on a live robot. Build it with:
#   make msgs-build MSGS_OVERLAY_DIR=./deploy/msgs_overlay/<robot>
# MUST start with ./ (compose treats a source without ./ as a named volume).
# The default 'robot' overlay ships empty -> standard types only (NOT an error).
# Point it at a per-robot overlay to use that robot's messages:
#   MSGS_OVERLAY_DIR=./deploy/msgs_overlay/<robot>
MSGS_OVERLAY_DIR=./deploy/msgs_overlay/robot

# ---- Sample-bag replay (deploy/test harness: make rosbag / rosbag-loop) ----
# Bag played by `make rosbag` / `make rosbag-loop`. Path is relative to data/
# (e.g. airoa-moma-mcap/000730); an absolute /data/... path also works. Unset =
# the bundled sample (airoa-moma-mcap/235210, see deploy/test/compose.yaml).
# BAG=airoa-moma-mcap/000730
# Uncomment to always loop (same effect as `make rosbag-loop`).
# LOOP=--loop
# ---- dora_live switchover (opt-in live backend, compose profile `live`) ----
# dora_live serves contract-compatible backends on its own ports:
#   8005 = topic_monitor-compatible (DORA_LIVE_PORT)
#   8006 = topic_probe-compatible   (DORA_LIVE_PROBE_PORT)
#   8007 = webrtc_streamer-compatible (DORA_LIVE_WEBRTC_PORT)
# Start it with:  docker compose --profile live up -d dora_live
#
# CAUTION: TOPIC_MONITOR_PORT / TOPIC_PROBE_PORT / WEBRTC_PORT are shared by
# the OLD service (as its bind port) and by the orchestrator/nginx (as the
# proxy target). Setting them here while the old services still run makes the
# old service bind the dora_live port on its next recreate (port collision).
#
# A) Trial switchover (old services keep running; shell-scoped env, .env unchanged):
#   TOPIC_MONITOR_PORT=8005 docker compose up -d orchestrator     # Monitor tab
#   WEBRTC_PORT=8007 TOPIC_PROBE_PORT=8006 docker compose up -d frontend  # Live/Probe tabs
#   (revert: rerun both commands without the variables)
#
# B) Full cutover (old live services retired) — uncomment AND stop the old ones:
#   docker compose stop monitor probe streamer
# TOPIC_MONITOR_PORT=8005
# TOPIC_PROBE_PORT=8006
# WEBRTC_PORT=8007
#
# 【日本語】dora_live への切替手順:
#   前提: docker compose --profile live up -d dora_live で dora_live を起動しておく。
#   注意: 上の3変数は「旧サービスの bind ポート」と「orchestrator/nginx の向き先」を
#         兼ねるため、旧サービス稼働中に .env へ書くと再作成時にポート衝突する。
#   A) お試し切替(.env は書き換えない・旧サービス並走・すぐ戻せる):
#      TOPIC_MONITOR_PORT=8005 docker compose up -d orchestrator   ← Monitorタブ
#      WEBRTC_PORT=8007 TOPIC_PROBE_PORT=8006 docker compose up -d frontend ← Live/Probeタブ
#      戻す: 変数を付けずに同じコマンドを再実行(または make restart orchestrator frontend)
#   B) 本切替(旧ライブ系を止めてから上の3行を有効化):
#      docker compose stop monitor probe streamer
#      → TOPIC_MONITOR_PORT=8005 / TOPIC_PROBE_PORT=8006 / WEBRTC_PORT=8007 を有効化
#   詳細: docs/specs/ja/dora_live.md
