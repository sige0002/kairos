# =============================================================================
# kairos — SINGLE-HOST setup.   cp .env.example .env
#
# Everything (robot services + console) runs on one PC.
# Recording from a SEPARATE PC than the robot? Use .env.split.example instead.
#
# Uncommented keys are the ones commonly tuned (values shown ARE the
# defaults — leaving them as-is changes nothing). Commented keys are the
# rarely-touched and opt-in ones; a commented line shows its default.
# Full schema and rationale: docs/specs/ja/config.md
# =============================================================================

# ---- robot ------------------------------------------------------------------
# Active robot: config/<robot>/ (committed) or config/local/<robot>/ (gitignored).
ROBOT=airoa_hsr
#CONFIG_DIR=config
#CONFIG_LOCAL_DIR=config/local

# ---- per-robot config paths (derived) ---------------------------------------
# `make` derives all of these from ROBOT. Set one ONLY to override that path —
# a stale absolute value here silently beats the robot you selected.
#RECORDING_CONFIG=/config/airoa_hsr/recording/default.yaml
#STREAM_CONFIG=/config/airoa_hsr/stream/default.yaml
#ALERT_CONFIG_PATH=/config/airoa_hsr/monitoring/alerts.yaml
#LOSS_REPORT_CONFIG=/config/airoa_hsr/validators/loss_report.yaml
#BAGFLOW_FLOWS_DIR=/config/airoa_hsr/flows
# Custom ROS message overlay, when the robot has one. Must start with ./
#MSGS_OVERLAY_DIR=./deploy/msgs_overlay/airoa_hsr

# ---- ROS 2 graph ------------------------------------------------------------
ROS_DOMAIN_ID=0
ROS_DISTRO=jazzy
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
# Cyclone only: unicast/peer tuning XML, read from the mounted /config.
#CYCLONEDDS_URI=file:///config/cyclonedds-localhost.xml

# ---- data + archive ---------------------------------------------------------
# Recording root on the host (mounted at /data in every container).
DATA_DIR=./data
# Archive is opt-in and needs BOTH lines: the host path to mount, and the
# in-container path allowed as a destination. One without the other is the trap
# where exports verify and then vanish with the container.
#ARCHIVE_DIR=/mnt/nas/kairos-archive
#KAIROS_ARCHIVE_ROOTS=/archive
# Mark recordings older than N days as deletion candidates; 0 disables.
RETENTION_DAYS=0

# ---- recording limits -------------------------------------------------------
# Hard wall-clock cap on ONE recording, in seconds; 0 disables.
MAX_RECORD_SECONDS=600
# Auto-stop a recording past this many bytes; 0 = unlimited.
MAX_RECORD_BYTES=0

# ---- ports ------------------------------------------------------------------
FRONTEND_PORT=8080
API_ORCH_PORT=8000
TOPIC_MONITOR_PORT=8001
WEBRTC_PORT=8002
TOPIC_PROBE_PORT=8003
RECORDER_PORT=8010
DORA_RUNNER_PORT=8020
# 0.0.0.0 exposes the stack on the LAN. There is no auth — trusted LAN only.
BIND_HOST=0.0.0.0

# ---- where each service lives -----------------------------------------------
# All co-located on one host, so every one of these stays local. The split
# deployment is what moves them. WEBRTC_HOST and PROBE_HOST are also the nginx
# upstreams the browser is proxied to; API_HOST is the orchestrator's.
#RECORDER_HOST=localhost
#TOPIC_MONITOR_HOST=localhost
#WEBRTC_HOST=localhost
#TOPIC_PROBE_HOST=localhost
#DORA_RUNNER_HOST=localhost
#IMPORTER_HOST=localhost
#API_HOST=127.0.0.1
#PROBE_HOST=127.0.0.1

# ---- browser-facing (frontend / WebRTC) -------------------------------------
# Same-origin path proxied by the frontend's nginx; works over LAN/tunnel/VPN
# with no CORS. An absolute http://host:8002 connects the browser direct.
WEBRTC_PUBLIC_URL=/webrtc
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
# STUN/TURN as a JSON array (browser RTCIceServer shape). Empty = LAN direct;
# a blank or malformed value degrades to no-ICE rather than failing to start.
#WEBRTC_ICE_SERVERS=[{"urls":["stun:stun.l.google.com:19302"]}]
# RTP payload cap. 1150 keeps datagrams under a 1280-MTU tunnel (Tailscale /
# WireGuard); raise to 1300 on a plain 1500-MTU LAN for less header overhead.
#WEBRTC_PACKET_MAX=1150
# 1 keeps IPv6 ICE candidates. Off by default: fragmented IPv6 media is
# black-holed by WireGuard, which is what turns a preview black over Tailscale.
#WEBRTC_KEEP_IPV6=0
# Bundled TURN relay (compose/turn.yaml). The IP is REQUIRED once that file is
# used — compose refuses to start without it. Change the credentials.
#TURN_EXTERNAL_IP=192.168.1.10
#TURN_USERNAME=kairos
#TURN_PASSWORD=changeme

# ---- Review video preview ---------------------------------------------------
# Default frame cap when video_check encodes a preview; 0 = the whole episode.
# Cap it only where encode time or disk for long episodes actually hurts.
VIDEO_MAX_FRAMES=0
# Default playback speed of that preview in Review.
VIDEO_PLAYBACK_RATE=4.0
# x264 encode knobs. Defaults trade NO quality (x264's own medium / crf 23)
# and cap threads at 4; set preset=veryfast where encode speed matters more.
#VIDEO_ENCODE_THREADS=4
#VIDEO_ENCODE_PRESET=medium
#VIDEO_ENCODE_CRF=23

# ---- dora_runner (validation / conversion jobs) -----------------------------
# Jobs executed at once, and the per-job wall-clock budget in seconds.
#KAIROS_DORA_MAX_CONCURRENCY=2
#KAIROS_DORA_JOB_TIMEOUT_S=900
# /dev/shm for the dora daemon; raise for wide multi-camera dataflows.
#DORA_RUNNER_SHM_SIZE=2gb
# Ports of the service's own dora coordinator/daemon (container-internal).
#KAIROS_DORA_CONTROL_PORT=6112
#KAIROS_DORA_DAEMON_PORT=53390
#KAIROS_DORA_DAEMON_LISTEN_PORT=53391
#KAIROS_DORA_COORDINATOR_ADDR=127.0.0.1
# 1 forces the in-process interpreter instead of the bundled dora CLI.
#KAIROS_DORA_INPROCESS=0
# Per-flow timeout in seconds for a bagflow validation run.
#KAIROS_BAGFLOW_TIMEOUT_S=600
# Extra plugin directory, on top of the in-tree services/dora_runner/plugins.
#KAIROS_PLUGINS_DIR=

# ---- replay harness (make rosbag / rosbag-loop / table / smoke) -------------
# Bag replayed by `make rosbag[-loop]`, as a path UNDER data/ (or /data/...).
BAG=airoa-moma-mcap/000730
# Set to --loop to make the single-shot `make rosbag` repeat too.
#LOOP=

# ---- operational ------------------------------------------------------------
LOG_LEVEL=INFO
# Container timezone; blank keeps UTC in logs and filenames.
#TZ=Asia/Tokyo
# Owner of files the containers write into ./data — keep as your own id.
#UID=1000
#GID=1000
# Stamped into GET /api/v1/system and the console footer.
#KAIROS_VERSION=dev
#KAIROS_GIT_SHA=unknown
# Which env file compose injects into containers; `make` sets this for splits.
#KAIROS_ENV_FILE=.env

# ---- proxy (only behind a corporate proxy) ----------------------------------
# Build-time passthrough. Every runtime call is LAN-internal, so exempt them
# or calls to your own services get routed to the proxy and fail.
#HTTP_PROXY=
#HTTPS_PROXY=
#NO_PROXY=localhost,127.0.0.1
