# The E2E stack's environment — a full, self-contained profile.
#
# It is deliberately NOT the repo's .env: the acceptance suite must be able to
# run beside a developer's own stack without stealing its ports, its ROS domain
# or its data directory. Every value here differs from the shipped defaults for
# exactly that reason, and `e2e/scripts/stack.sh` exports the whole file so a
# stray `ROBOT=` in the shell (or a `make` export) cannot win over it.
#
# Two consumers, one file:
#   * `docker compose --env-file` reads it to interpolate the compose file
#     (ports, image tags, and the HOST side of the data mount).
#   * the services read a GENERATED copy (`.run/service.env`, written by
#     stack.sh) whose DATA_DIR is rewritten to the in-container /data. That is
#     the one value whose host and container meaning differ, so it is the one
#     value the script overrides — everything else stays in one place.

# ---- ROS graph --------------------------------------------------------------
# 42 is not 0: the replayed bag must reach the recorder and nothing else. Other
# stacks on this host (and any robot on the LAN) sit on their own domain, so a
# stray publisher cannot end up inside an acceptance recording.
ROS_DOMAIN_ID=42
ROS_DISTRO=jazzy
RMW_IMPLEMENTATION=rmw_fastrtps_cpp

# ---- data -------------------------------------------------------------------
# Host path, relative to the repo root (compose resolves volume paths against
# the compose file's directory). Wiped and recreated by `stack.sh reset`, so a
# run never inherits the previous run's captures.
DATA_DIR=./e2e/.run/data

# The container-side env file stack.sh generates from this one.
KAIROS_ENV_FILE=e2e/.run/service.env

# ---- robot / config ---------------------------------------------------------
# airoa_hsr is the bundled sample config, and its default_topics are exactly the
# standard-typed topics of data/airoa-moma-mcap/* — so the replay needs no
# custom-message overlay and the recording is reproducible from a clean clone.
ROBOT=airoa_hsr
RECORDING_CONFIG=/config/airoa_hsr/recording/default.yaml
STREAM_CONFIG=/config/airoa_hsr/stream/default.yaml
LOSS_REPORT_CONFIG=/config/airoa_hsr/validators/loss_report.yaml
BAGFLOW_FLOWS_DIR=/config/airoa_hsr/flows
CONFIG_DIR=/config
CONFIG_LOCAL_DIR=/config/local
# The sample bag has no custom types among the recorded topics; the empty
# overlay keeps the recorder from sourcing a robot-specific one.
MSGS_OVERLAY_DIR=./deploy/msgs_overlay/robot

# ---- ports (offset by 10000 from the shipped defaults) ----------------------
BIND_HOST=127.0.0.1
API_ORCH_PORT=18000
TOPIC_MONITOR_PORT=18001
WEBRTC_PORT=18002
TOPIC_PROBE_PORT=18003
RECORDER_PORT=18010
DORA_RUNNER_PORT=18020
FRONTEND_PORT=18080
# dora's own coordinator/daemon. Host networking makes these host-wide, so they
# are offset too — an acceptance run must never adopt a developer's dora.
KAIROS_DORA_CONTROL_PORT=16112
KAIROS_DORA_DAEMON_PORT=53490
KAIROS_DORA_DAEMON_LISTEN_PORT=53491

# ---- archive (§6.1 / scenario 6) --------------------------------------------
# The one allow-listed archive root, as the CONTAINER sees it. The host side
# (e2e/.run/archive) is mounted by e2e/compose.archive.yaml and wiped by
# `stack.sh reset` together with the data dir — an acceptance run must not
# find another run's exports at its destination (the run refuses a non-empty
# one, correctly, and the scenario would fail for the wrong reason).
KAIROS_ARCHIVE_ROOTS=/archive

# ---- misc -------------------------------------------------------------------
WEBRTC_PUBLIC_URL=/webrtc
CORS_ORIGINS=http://localhost:18080
LOG_LEVEL=INFO
# Retention/size caps off: an acceptance run must not have data swept out from
# under it by a background policy.
RETENTION_DAYS=0
MAX_RECORD_BYTES=0
