<?xml version="1.0" encoding="UTF-8"?>
<!--
  Fast DDS profile: UDPv4 only (shared-memory transport disabled).

  Why: Isaac Sim and the ROS 2 container are separate containers. Even on
  `network_mode: host`, the default Fast DDS shared-memory transport uses
  /dev/shm segments that do not line up reliably across container mount
  namespaces, which silently drops discovery/data. Forcing UDPv4 makes
  the Isaac Sim <-> ROS 2 bridge talk over the (shared) host loopback/LAN.

  Both containers mount this file and set:
    FASTRTPS_DEFAULT_PROFILES_FILE=<path to this file>
    RMW_IMPLEMENTATION=rmw_fastrtps_cpp
    ROS_DOMAIN_ID=0
-->
<dds xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <profiles>
    <transport_descriptors>
      <transport_descriptor>
        <transport_id>udp_transport</transport_id>
        <type>UDPv4</type>
      </transport_descriptor>
    </transport_descriptors>

    <participant profile_name="udp_only" is_default_profile="true">
      <rtps>
        <userTransports>
          <transport_id>udp_transport</transport_id>
        </userTransports>
        <useBuiltinTransports>false</useBuiltinTransports>
      </rtps>
    </participant>
  </profiles>
</dds>
