{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Edit(docs/**)",
      "Write(docs/**)",
      "Edit(CLAUDE.ja.md)",
      "Write(CLAUDE.ja.md)",
      "Edit(README.ja.md)",
      "Write(README.ja.md)",
      "Edit(CLAUDE.md)",
      "Write(CLAUDE.md)",
      "Edit(README.md)",
      "Write(README.md)",
      "Read(./**/.env.example)",
      "Edit(./**/.env.example)",
      "Write(./**/.env.example)"
    ],
    "deny": [
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/secrets/**)"
    ]
  }
}
